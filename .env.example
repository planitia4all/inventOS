# InventOS 환경변수 설정
# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요. .env는 git에 커밋되지 않습니다.

# 사용자 정보
INVENTOS_USER_NAME=

# 데이터 저장 경로 (기본값: ./data)
INVENTOS_DATA_DIR=

# 언어 설정 (ko, en)
INVENTOS_LANGUAGE=ko

# 기본 특허 검색 결과 수
INVENTOS_DEFAULT_SEARCH_LIMIT=20

# ---- 특허 Provider ----
KIPRIS_API_KEY=
EPO_OPS_CLIENT_KEY=
EPO_OPS_CLIENT_SECRET=
USPTO_API_KEY=

# ---- AI Provider ----
# ai_provider: mock | anthropic | openai
INVENTOS_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
